# ── Mercado Pago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Chaves RSA (JWT RS256) ────────────────────────────────────────────────────
# DEV LOCAL: deixe em branco — usa os arquivos keys/private.pem e keys/public.pem
# PRODUÇÃO (Railway/Render): cole o conteúdo do .pem substituindo quebras de linha por \n
#
# Como converter para uma linha só (PowerShell):
#   (Get-Content keys\private.pem -Raw) -replace "`r`n","\n" -replace "`n","\n"
#
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Email (Gmail — use senha de app, não a senha normal) ──────────────────────
# Como gerar: myaccount.google.com > Segurança > Senhas de app
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Shopee Affiliate Bot

# ── Produto ───────────────────────────────────────────────────────────────────
PRODUCT_NAME=Shopee Affiliate Bot
PRODUCT_PRICE=79.90
LICENSE_DURATION_DAYS=365

# ── Servidor ──────────────────────────────────────────────────────────────────
# Em produção: URL pública do Railway/Render (sem barra final)
SERVER_URL=https://seu-app.up.railway.app
# DATABASE_URL é injetado automaticamente pelo Railway/Render ao adicionar PostgreSQL
# DATABASE_URL=sqlite:///./licenses.db  ← só para dev local
